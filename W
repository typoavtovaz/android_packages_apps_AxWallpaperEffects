name: Build APK

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: lineage-23.2

      - uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Setup Gradle
        run: |
          gradle wrapper --gradle-version 8.2

      - name: Create build.gradle
        run: |
          cat > build.gradle << 'EOF'
          apply plugin: 'com.android.application'
          android {
            compileSdk 34
            defaultConfig {
              applicationId "com.android.axion.wallpapereffects"
              minSdk 31
              targetSdk 34
            }
          }
          EOF

      - name: Build APK
        run: ./gradlew assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: WallpaperEffects
          path: "**/*.apk"
